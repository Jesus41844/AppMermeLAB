# Archivo de entorno para AppMermeLAB
# Copia este archivo a .env y ajusta los valores antes de ejecutar la app.

# Flask
FLASK_ENV=development

# JWT
JWT_SECRET_KEY=tu_secreto_seguro_aqui

# Base de datos
# Sin esta variable la app usa backend/mermelab_v2.db con ruta absoluta.
# Si la defines, ponla absoluta: una ruta relativa se resuelve contra el
# directorio desde el que se lanza la app y SQLite no encuentra el archivo.
# DATABASE_URL=sqlite:////ruta/absoluta/a/mermelab_v2.db

# CORS
CORS_ORIGINS=http://localhost:5000
